# LobeChat Development Environment Configuration
# ⚠️ DO NOT USE THESE VALUES IN PRODUCTION!

# Application
APP_URL=http://localhost:3010

# Allow access to private IP addresses (localhost services) in development
# https://lobehub.com/docs/self-hosting/environment-variables/basic#ssrf-allow-private-ip-address
SSRF_ALLOW_PRIVATE_IP_ADDRESS=1

# Secrets (pre-generated for development only)
KEY_VAULTS_SECRET=ww+0igxjGRAAR/eTNFQ55VmhQB5KE5trFZseuntThJs=
AUTH_SECRET=ww+0igxjGRAAR/eTNFQ55VmhQB5KE5trFZseuntThJs=

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:change_this_password_on_production@localhost:5432/lobechat
DATABASE_DRIVER=node

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=lobechat
REDIS_TLS=0

# S3 Storage (RustFS)
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=change_this_password_on_production
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lobe
S3_ENABLE_PATH_STYLE=1
S3_SET_ACL=0

# LLM vision uses base64 to avoid S3 presigned URL issues in development
LLM_VISION_IMAGE_USE_BASE64=1

# Search (SearXNG)
SEARXNG_URL=http://localhost:8180

# Proxy (Optional)
# HTTP_PROXY=http://localhost:7890
# HTTPS_PROXY=http://localhost:7890

# AI Model API Keys (Required for chat functionality)
# In commercial local testing with ENABLE_PLATFORM_HOSTED_MODELS=1, these keys
# are platform-side service credentials, not user BYOK fields.
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_PROXY_URL=https://api.anthropic.com

# OPENAI_API_KEY=sk-xxx
# OPENAI_PROXY_URL=https://api.openai.com/v1

# New API platform runtime credentials. In platform-hosted mode, every catalog
# model routes through providerId=newapi and these server-side credentials.
NEWAPI_API_KEY=sk-local-newapi-example
NEWAPI_PROXY_URL=http://localhost:3000/v1

# Commercial runtime gates for local commercial testing. When
# ENABLE_PLATFORM_HOSTED_MODELS=1, provider API keys are platform-side service
# credentials, not user BYOK fields.
ENABLE_COMMERCIAL=1
ENABLE_NATIVE_BILLING=1
ENABLE_PLATFORM_HOSTED_MODELS=1
ENABLE_LOBEHUB_CLOUD_INTEGRATION=0

# Legacy compatibility flag for older platform billing checks. Keep enabled
# while local platform billing/model catalog work still reads it.
NEXT_PUBLIC_ENABLE_PLATFORM_BILLING=1

# Local/test only: allows mock payment URLs when real channel signing credentials are absent.
# Never enable this in production.
BILLING_ALLOW_MOCK_PAYMENTS=1

# Credits defaults and risk limits for local billing tests.
BILLING_TRIAL_CREDITS=500000
BILLING_TRIAL_VALID_DAYS=30
BILLING_FREE_DAILY_LIMIT=1000000
BILLING_PAID_DAILY_LIMIT=10000000

# Real payment credentials are server-side only. Leave commented when using
# BILLING_ALLOW_MOCK_PAYMENTS=1 for local development.
# ALIPAY_APP_ID=2026000000000000
# ALIPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----LOCAL_DEV_ALIPAY_PRIVATE_KEY-----END PRIVATE KEY-----
# ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----LOCAL_DEV_ALIPAY_PUBLIC_KEY-----END PUBLIC KEY-----
# ALIPAY_NOTIFY_URL=http://localhost:3010/api/payments/alipay/notify

# WECHAT_PAY_MCH_ID=1900000001
# WECHAT_PAY_APP_ID=wx0000000000000000
# WECHAT_PAY_API_V3_KEY=local-dev-wechat-pay-api-v3-key
# WECHAT_PAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----LOCAL_DEV_WECHAT_PRIVATE_KEY-----END PRIVATE KEY-----
# WECHAT_PAY_SERIAL_NO=LOCALDEVWECHATSERIALNO
# WECHAT_PAY_NOTIFY_URL=http://localhost:3010/api/payments/wechat/notify
